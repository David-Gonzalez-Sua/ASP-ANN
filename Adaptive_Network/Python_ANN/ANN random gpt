import numpy as np

from ann import ANN

# ---------------------------
# Dataset generator
# ---------------------------

def generate_dataset(num_samples=100, num_inputs=3, num_outputs=1):
    """
    Generates a random dataset.
    Inputs: floats between 0 and 1.
    Outputs: 0 or 1 based on a simple rule so the network can learn.
    """
    X = np.random.rand(num_samples, num_inputs)
    
    # Simple target: 1 if sum(inputs) > threshold, else 0
    threshold = num_inputs * 0.5
    y = (np.sum(X, axis=1) > threshold).astype(float).reshape(-1, num_outputs)
    
    return X, y

# ---------------------------
# Split into training and testing
# ---------------------------

def train_test_split(X, y, test_ratio=0.2):
    num_samples = X.shape[0]
    indices = np.arange(num_samples)
    np.random.shuffle(indices)
    
    split = int(num_samples * (1 - test_ratio))
    train_idx, test_idx = indices[:split], indices[split:]
    
    return X[train_idx], y[train_idx], X[test_idx], y[test_idx]

# ---------------------------
# Example usage
# ---------------------------

# Generate 200 samples with 3 inputs and 1 output
X, y = generate_dataset(num_samples=200, num_inputs=3, num_outputs=1)
X_train, y_train, X_test, y_test = train_test_split(X, y)

print("Training data shape:", X_train.shape, y_train.shape)
print("Testing data shape:", X_test.shape, y_test.shape)

# Optional: check the first few samples
print("\nSample training inputs:\n", X_train[:5])
print("Sample training outputs:\n", y_train[:5])

# ---------------------------
# Building the ANN
# ---------------------------
network = ANN()
network.build_network(input_size=3, hidden_size=5, num_hidden_layers=2, output_size=1)

# ---------------------------
# Training loop
# ---------------------------
epochs = 1000
alpha = 0.01  # learning rate

for epoch in range(epochs):
    total_error = 0
    for x_sample, y_sample in zip(X_train, y_train):
        # x_sample = x_sample / x_sample.max()  # Normalize input sample to [0, 1]
        # y_sample = y_sample / y_sample.max()  # Normalize target output to [0, 1]
        x_sample = x_sample / np.max(x_sample) if np.max(x_sample) > 0 else x_sample
        y_sample = y_sample / np.max(y_sample) if np.max(y_sample) > 0 else y_sample

        # Forward pass
        network.forward_pass(x_sample)
        
        # Backward pass / weight update
        network.backward_pass(y_sample, alpha=alpha)
        
        # Compute squared error for monitoring
        output_values = [neuron.value for neuron in network.output_layer]
        sample_error = 0.5 * np.sum((np.array(output_values) - y_sample) ** 2)
        total_error += sample_error

    if epoch % 100 == 0:
        print(f"Epoch {epoch}, total training error: {total_error:.4f}")

# ---------------------------
# Testing / evaluation
# ---------------------------
correct = 0
for x_sample, y_sample in zip(X_test, y_test):
    # x_sample = x_sample / x_sample.max()  # Normalize input sample to [0, 1]
    # y_sample = y_sample / y_sample.max()  # Normalize target output to [0, 1]
    x_sample = x_sample / np.max(x_sample) if np.max(x_sample) > 0 else x_sample
    y_sample = y_sample / np.max(y_sample) if np.max(y_sample) > 0 else y_sample

    network.forward_pass(x_sample)
    predicted = np.array([neuron.value for neuron in network.output_layer])
    
    # Binary classification: round to 0 or 1
    predicted_label = np.round(predicted)
    
    if predicted_label == y_sample:
        correct += 1

accuracy = correct / len(X_test)
print(f"Test accuracy: {accuracy*100:.2f}%")

