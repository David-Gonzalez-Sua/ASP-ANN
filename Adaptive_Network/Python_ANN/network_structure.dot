
digraph G {
    rankdir=LR; // makes the graph flow left-to-right
    splines=line;

    node [
        shape=circle,
        fixedsize=true,
        width=0.5,
        fontsize=10
    ];

    edge [
        arrowsize=0.5,
        fontsize=8,
        labeldistance=2,
        labelangle=30
    ];
    
    // Align all inputs from a given layer
    { rank=same;
      input_0 [label=0] ;
      input_1 [label=0] ;
      input_2 [label=0] ;
      input_3 [label=0] ;
      input_4 [label=0] ;
    }

    { rank=same;
